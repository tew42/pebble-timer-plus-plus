  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Display Updates"
      },
      {
        "type": "text",
        "defaultValue": "Redrawing every second is what uses the battery. These settings redraw less often while the time is a long way from zero; digits no longer being refreshed show as _ rather than a stale value. Select brings the exact time back: it pauses a countdown, and splits the stopwatch."
      },
      {
        "type": "select",
        "messageKey": "tenSecondUpdatesAbove",
        "label": "10-second updates above",
        "description": "Redraw every 10 seconds from this far out, showing 5:3_.",
        "serializeValueAs": "integer",
        "defaultValue": "255",
        "options": [
          { "label": "Never", "value": "255" },
          { "label": "20 seconds", "value": "20" },
          { "label": "40 seconds", "value": "40" },
          { "label": "60 seconds", "value": "60" },
          { "label": "90 seconds", "value": "90" },
          { "label": "120 seconds", "value": "120" }
        ]
      },
      {
        "type": "select",
        "messageKey": "minuteUpdatesAbove",
        "label": "Minute updates above",
        "description": "Redraw once a minute from this far out, showing 5:__. Set at or below the 10-second setting, this takes over and switches that one off.",
        "serializeValueAs": "integer",
        "defaultValue": "255",
        "options": [
          { "label": "Never", "value": "255" },
          { "label": "1 minute", "value": "1" },
          { "label": "2 minutes", "value": "2" },
          { "label": "3 minutes", "value": "3" },
          { "label": "5 minutes", "value": "5" },
          { "label": "7 minutes", "value": "7" },
          { "label": "10 minutes", "value": "10" }
        ]
      }
    ]
  },
  {
