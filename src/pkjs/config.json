  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Instant Start"
      },
      {
        "type": "text",
        "defaultValue": "Inspired by QuickTimer by jazzabeanie. The seconds spent setting a timer are seconds the timer is out by, so the clock can be made to run from the moment you opened the app. The first press of select, up or down calls off the automatic start but keeps the credit, which is capped at the interval chosen below."
      },
      {
        "type": "select",
        "messageKey": "instantStart",
        "label": "Instant start",
        "description": "Start the clock the moment the app opens, or is reset, rather than when you press select. With nothing pressed by then, the stopwatch starts on its own.",
        "serializeValueAs": "integer",
        "defaultValue": "255",
        "options": [
          {
            "label": "Off",
            "value": "255"
          },
          {
            "label": "5 seconds",
            "value": "5"
          },
          {
            "label": "10 seconds",
            "value": "10"
          },
          {
            "label": "15 seconds",
            "value": "15"
          }
        ]
      }
    ]
