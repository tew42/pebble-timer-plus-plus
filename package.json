    "resources": {
      "media": [
        {
          "file": "images/icon_bw.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "memoryFormat": "1Bit",
          "menuIcon": true,
          "targetPlatforms": [
            "aplite",
            "diorite",
            "flint"
          ]
        },
        {
          "file": "images/icon_color.png",
          "type": "bitmap",
          "name": "MENU_ICON",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "emery",
            "gabbro"
          ]
        },
        {
          "type": "font",
          "name": "BEBAS_FONT_35",
          "file": "fonts/bebas_neue_regular.ttf",
          "characterRegex": "[0-9: ]"
        }
      ]
    }
  }
}
