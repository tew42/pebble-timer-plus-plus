{
  "name": "timer-plus-plus",
  "author": "Thomas Winkler",
  "version": "1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0",
    "pebble-scalable": "^2.2.0"
  },
  "pebble": {
    "displayName": "Timer++",
    "uuid": "c1a8292f-bf99-44ee-888c-517a7f2a48f1",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "tenSecondUpdatesAbove",
      "minuteUpdatesAbove",
      "timerColor",
      "chronoColor"
